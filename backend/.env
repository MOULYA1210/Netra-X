# Server
PORT=5000
NODE_ENV=development

MONGO_URI=

# CORS
CLIENT_URL=http://localhost:5173
PING_INTERVAL_SECONDS=30
SNMP_INTERVAL_SECONDS=120

# Add this line:
AI_SERVICE_URL=http://localhost:5001

RULE_INTERVAL_SECONDS=


# Email config — choose one option:

# Option A: Gmail (enable App Passwords in Google Account settings)
SMTP_SERVICE=
SMTP_USER=
SMTP_PASS=

# Option B: Generic SMTP
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-key

# Alert recipients (comma-separated)
ALERT_EMAIL_TO=

# Escalation
ESCALATION_ENABLED=